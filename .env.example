# Copy to .env for local development. On Render, set these under the web service > Environment.
# Render: use the Internal Database URL of your Render PostgreSQL instance (External URL when connecting from outside Render).
DATABASE_URL=postgres://user:password@localhost:5432/sms
# Long random string used to sign session cookies (required in production).
SESSION_SECRET=change-me-to-a-long-random-string
# Optional: one-time token that allows creating the first administrator from the /setup page.
SETUP_TOKEN=
# Optional: port for the web server (Render sets PORT automatically).
PORT=5000
